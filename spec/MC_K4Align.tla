---------------------------- MODULE MC_K4Align -----------------------------
(***************************************************************************)
(* Model values for K4Align (DESIGN v1.13 §4b). Each cfg sets the scalar   *)
(* constants and substitutes Shape with one of the records below.          *)
(*                                                                         *)
(* Scaling (real -> model), every ratio kept:                              *)
(*   TileK 64 -> 8, AlignQ 16 -> 2 (TileK / AlignQ = 4: the k̂ mod 64       *)
(*   classes 0, 16, 32, 48 -> 0, 2, 4, 6), BaseAlign 256 -> 32             *)
(*   (BaseAlign / TileK = 4), K_c 131071 -> 23 (K_c ≡ TileK − 1 mod TileK  *)
(*   in both), so K_c' = ⌊23/8⌋·8 = 16 (131008), the class-32 alternative  *)
(*   ⌊23/4⌋·4 = 20 (131040, ≡ 4 = TileK/2) and the old ⌊23/2⌋·2 = 22       *)
(*   (131056, ≡ 6 = 3·AlignQ, as 131056 ≡ 48), K_PAD64_MIN 96 -> 12        *)
(*   (= 1.5 TileK, as 96 = 1.5·64), k = 1..40: k̂ up to 40 = 2.5 K_c', so  *)
(*   one-, two- and three-chunk plans of both alignments occur.            *)
(*   Shapes: b = 2 batches, m = n = 3 rows (n̂ = 4: the pack's B role reads *)
(*   one row past each block, into the next block or the tail), N = 3,     *)
(*   g = 2 (a short last group), gridDim.z parts of MaxZ = 3 batches       *)
(*   (|G|·b = 4: a part boundary inside a group), gridDim.y parts of       *)
(*   YLen = 2 columns (two y parts). ShapeTiny: b = m = n = 1 (n̂ = 2),     *)
(*   g = N = 3 (one group), one batch per z part.                          *)
(*                                                                         *)
(* Positive models (must pass):                                            *)
(*   pos_auto        the rule; Aligned16, TileStartsAligned,               *)
(*                   MainLoopAligned, ExtentOK, PadBounded                 *)
(*   pos_auto_tiny   the same on ShapeTiny                                 *)
(*   pos_<mutation>  each mutation is CORRECT (Aligned16, ExtentOK), it is *)
(*                   only slow; pos_stride_only also keeps                 *)
(*                   TileStartsAligned: its loss is purely the residue-    *)
(*                   first shift of the main loop                          *)
(* Negative models (must fail with the named invariant; the correctness    *)
(* invariants are listed first, so the first violation TLC finds is the    *)
(* alignment one):                                                         *)
(*   neg_stride_only      MainLoopAligned                                  *)
(*   neg_partial_landing  MainLoopAligned                                  *)
(*   neg_kc32             MainLoopAligned  (K_c' = 131040 analog)          *)
(*   neg_kc_old           MainLoopAligned  (K_c' = 131056 analog, A = 64)  *)
(*   neg_a32              TileStartsAligned (A = 32 analog)                *)
(*   neg_base16           TileStartsAligned (16-aligned bases)             *)
(* Witnesses (must fail on the design):                                    *)
(*   neg_witness_a16_misaligned  EveryPlanAligned (k ≤ K_PAD64_MIN plans,  *)
(*                   A = 16, are misaligned: the threshold is a choice)     *)
(*   neg_witness_multichunk      NoMultiChunkA64 (an A = 64 plan with ≥ 2  *)
(*                   K-chunks is checked)                                  *)
(***************************************************************************)
EXTENDS K4Align

ShapeBase == [b |-> 2, m |-> 3, n |-> 3, g |-> 2, N |-> 3, MaxZ |-> 3, YLen |-> 2]
ShapeTiny == [b |-> 1, m |-> 1, n |-> 1, g |-> 3, N |-> 3, MaxZ |-> 1, YLen |-> 2]
=============================================================================
