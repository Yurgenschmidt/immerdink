(*                                                                         *)
(* DESIGN §3.6 running CRT at the REAL width, N = 20, L_w = 160         *)
(* (L32 = 5 u32 limbs), symbolically (Apalache: unbounded SMT ints):   *)
(*                                                                         *)
(*   x <- 0                                                                *)
(*   for l = 1..N:  y <- (q_l W_l) mod p_l      (any value in [0, p_l):    *)
(*                                               q_l is invertible mod p_l *)
(*                                               and W_l ranges over       *)
(*                                               [0, p_l), so every y is   *)
(*                                               reachable)                *)
(*                  x <- x + M_l y;  if x >= P: x <- x - P                 *)
(*                                                                         *)
(* State: l (next modulus), x (the word), y (the digit the next step       *)
(* adds). Claims, proved as an inductive invariant (check.sh runs          *)
(* Init => IndInv, IndInv /\ Next => IndInv', IndInv => Safety):           *)
(*   XBelowP        x < P after every step (so the centering z = x or      *)
(*                  x - P of §3.6 is valid);                               *)
(*   PeakBound      the un-reduced value x + M_l y < 2P;                    *)
(*   NoWordOverflow x + M_l y < 2^L_w: the peak fits the unsigned word     *)
(*                  (2P <= 2^L_w).                                         *)
(* The exact reachable peak (params.py crt_peak_exact, proved there by a   *)
(* formula brute-forced on scaled tables only) is checked here at the real *)
(* width by bounded model checking from Init over all N steps, i.e. over   *)
(* EVERY reachable state:                                                  *)
(*   PeakAtMostCert x + M_l y <= CrtPeak holds (no error), and             *)
(*   PeakBelowCert  x + M_l y <  CrtPeak is VIOLATED (expected): the peak  *)
(*                  is attained. CrtPeak >= 2^(L_w - 32) (WordNarrow,     *)
(*                  constant), so one limb fewer really overflows.        *)
(* Expected violation: XBelowP under NextNoSub (no conditional             *)
(* subtraction).                                                           *)
(***************************************************************************)
EXTENDS Integers

N      == 20
Lw     == 160
TwoLw  == 1461501637330902918203684832716283019655932542976        \* 2^160
TwoLwNarrow == 340282366920938463463374607431768211456  \* 2^128
CrtPeak == 117924979572927774951663290419562900861056236797
P      == 59079700598002655956659983298716520937586883840
\* @type: Seq(Int);
Mods   == <<256, 255, 253, 251, 247, 241, 239, 233, 229, 227, 223, 217, 211, 199, 197, 193, 191, 181, 179, 173>>
\* @type: Seq(Int);
Ms     == <<230780080460947874830703059760611409912448765, 231685100384324141006509738426339297794458368, 233516603154160695480869499204413126235521280, 235377293219134087476733001190105661105923840, 239189071246974315614008029549459598937598720, 245143985883828447952945988791354858662186240, 247195399991642911952552231375382932793250560, 253560946772543587796823962655435712178484480, 257989958943243039112052328815355986627016960, 260262998229086590117444860346768814703025920, 264931392816155407877399028245365564742542080, 272256684783422377680460752528647561924363520, 279998581033187942922559162553158867002781440, 296882917577902793752060217581490054962748160, 299896957350267289120101438064550867703486720, 306112438331619979050051726936355030764698880, 309317804178024376736439703134641470877418240, 326407185624324066058894935352024977555728640, 330054193284931038864022253065455424232328960, 341501159526026913044277360108187982298190080>>

VARIABLES
    \* @type: Int;
    l,
    \* @type: Int;
    x,
    \* @type: Int;
    y

\* The digit for modulus i: y in [0, p_i) (p_i <= 256).
Digit(i, v) == v \in 0..255 /\ (i <= N => v < Mods[i])

Init == l = 1 /\ x = 0 /\ y \in 0..255 /\ Digit(1, y)

Reduce(t) == IF t >= P THEN t - P ELSE t

Next ==
    /\ l <= N
    /\ x' = Reduce(x + Ms[l] * y)
    /\ l' = l + 1
    /\ y' \in 0..255 /\ Digit(l + 1, y')

\* Negative: the conditional subtraction dropped.
NextNoSub ==
    /\ l <= N
    /\ x' = x + Ms[l] * y
    /\ l' = l + 1
    /\ y' \in 0..255 /\ Digit(l + 1, y')

XBelowP        == x < P
PeakBound      == l <= N => x + Ms[l] * y < 2 * P
NoWordOverflow == l <= N => x + Ms[l] * y < TwoLw
WordFits       == 2 * P <= TwoLw
WordNarrow     == TwoLwNarrow <= CrtPeak /\ CrtPeak < 2 * P
Safety         == XBelowP /\ PeakBound /\ NoWordOverflow /\ WordFits /\ WordNarrow
PeakAtMostCert == l <= N => x + Ms[l] * y <= CrtPeak
PeakBelowCert  == l <= N => x + Ms[l] * y < CrtPeak

IndInv ==
    /\ l \in 1..(N + 1)
    /\ x \in 0..(P - 1)
    /\ y \in 0..255
    /\ Digit(l, y)
