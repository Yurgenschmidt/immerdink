---------------------------- MODULE MC_Pipeline ----------------------------
(***************************************************************************)
(* Model values for Pipeline. Each MC_Pipeline__*.cfg picks one set.       *)
(*                                                                         *)
(* Scaling (real -> model):                                                *)
(*   alignment  AlignK = AlignN 16 -> 2.                                   *)
(*              AlignWS 256 -> 32 in most positives: this keeps the real   *)
(*              ratio AlignWS / AlignK = 16, and it lies strictly above    *)
(*              the widest element (int64), so align() is NOT a no-op on   *)
(*              the int64 vec region (8·VecLen is 152 / 144 / 176 here,    *)
(*              none a multiple of 32): forgetting to align vec misaligns  *)
(*              RA/RB/W, as it would at real size.                         *)
(*              AlignWS 256 -> 8 in pos_g1 / pos_two_streams /             *)
(*              pos_pad_minimal / pos_empty and the negatives: with 8 the  *)
(*              last region W (24 bytes) ends exactly at workspace_size,   *)
(*              so ws_bytes = workspace_size - 1 (neg_ws_short) is         *)
(*              boundary + 1 for the bound. Both satisfy the               *)
(*              preconditions AlignWS % 8 = 0, AlignWS % AlignK = 0.       *)
(*   K_c'       131008 (v1.13: a multiple of 64 = 4·AlignK, hence of 16;   *)
(*              it was 131056) -> ChunkLen 2 (= AlignK, the boundary of    *)
(*              "multiple of AlignK") or 4 (> AlignK, with k̂ = 6 not a    *)
(*              multiple of it: a short last chunk, the normal real case   *)
(*              k̂ mod 131008 ≠ 0). The 64-byte load phase (v1.13 §4b) is   *)
(*              a performance contract, not modelled here.                 *)
(*   gridDim.z  65535 -> MaxZ 1..3 (set ON the |G|·b boundary or below it  *)
(*              so the launch split is exercised)                          *)
(*   gridDim.y  65535 N tiles -> MaxY 1..2, threadblock N (128/256) ->     *)
(*              TileN 2..4 (a multiple of AlignN) in the pos_ysplit*       *)
(*              models; elsewhere TileN = 16 >= n̂, MaxY = 1: one partial   *)
(*              N tile, one launch (the real small-n case; same states as  *)
(*              before the n̂ split was modelled).                          *)
(*   shapes     b = 1, m = 2, n = 3, k = 3, N = 3 ("P1"): k̂ = 4 (two       *)
(*              K-chunks, the second containing the K padding h = 3),      *)
(*              n̂ = 4 (one zero B row), N mod 2 ≠ 0 (a short last group). *)
(*              The batched models use m ≠ n (2,1 and 1,2) so a row/column *)
(*              stride mix-up (m vs n) changes some address.               *)
(*   element widths and all index arithmetic are the real ones.            *)
(*                                                                         *)
(* Workspace sizes (§4a; region terms sA sB fA fB vec RA RB W):            *)
(*   P1, AlignWS = 8:   8 8 8 8 152 8g 16g 24  => 208 + 24g (232/256/280)  *)
(*   P1, AlignWS = 32:  32 32 32 32 160 32 32|64 32 => 384 (g ≤ 2), 416   *)
(*   pos_batch2:        32·4 + 160 + 32 + 32 + 32 = 384                    *)
(*   pos_shortchunk:    32·4 + 192 + 32 + 32 + 32 = 416                    *)
(*                                                                         *)
(* Positive models (must pass), all with ws_bytes = workspace_size:        *)
(*   pos_g1           g = 1 (3 groups, maximal RA/RB reuse), MaxZ = |G|·b  *)
(*   pos_g2           g = 2 (groups {1,2},{3}), MaxZ = 1 < |G|·b (split)   *)
(*   pos_g3           g = N (one group, no reuse), MaxZ = |G|·b            *)
(*   pos_two_streams  packs on a 2nd stream WITH the three event edges.    *)
(*                    NOTE: these edges serialize the side stream fully    *)
(*                    (pack(G+1) waits for every GEMM of G, GEMM(G) for    *)
(*                    both packs of G, K5 is on the main stream), so this  *)
(*                    shows the edges are SUFFICIENT, not that an          *)
(*                    overlapped schedule is safe. An overlapped pack       *)
(*                    stream would need double-buffered RA/RB (2 slots,    *)
(*                    WAR edge to gemm(G-1)) and its own positive model.   *)
(*   pos_batch2       b = 2, m = 2, n = 1, g = 2: batch strides, split     *)
(*                    {0,1,2},{3}                                          *)
(*   pos_shortchunk   b = 2, m = 1, n = 2, k̂ = 6, K_c' = 4: chunks         *)
(*                    [0,4),[4,6)                                          *)
(*   pos_k0           k = 0: vec-only workspace, C <- β·C, A/B not read    *)
(*   pos_direct       DIRECT mode: vec-only workspace, native kernel       *)
(*   pos_kempty       K-empty (k = 1) in mode EMULATE: dispatched by the   *)
(*                    descriptor to DIRECT, vec-only workspace; exactly-   *)
(*                    once, read rules (α = 0, β = 0) on that path         *)
(*   pos_empty        m = 0: no kernels, 0 workspace                       *)
(*   pos_ysplit       n̂ split (gridDim.y): n̂ = 4, TileN = 2, MaxY = 1: two *)
(*                    launches of one tile, exact fit (GridY = MaxY, the   *)
(*                    launch width = YLen ON the boundary); g = 1, 2 chunks *)
(*   pos_ysplit_short n̂ = 6, TileN = 2, MaxY = 2 (YLen = 4) with the z     *)
(*                    split (MaxZ = 1): launch 0 has GridY = MaxY, the     *)
(*                    last launch is short (one tile)                      *)
(*   pos_ysplit_tile  n̂ = 6, TileN = 4, MaxY = 1: the last launch is one   *)
(*                    PARTIAL tile (2 < TileN columns)                     *)
(*   pos_pad_minimal  HARMLESS deviation: K padding zeroed in A only, by   *)
(*                    group 1 only; B rows n..n̂ never written. Shows that  *)
(*                    DESIGN's padding rule is sufficient, not minimal.    *)
(* v1.2: every model above runs K1 as one launch (K1Split = FALSE: the    *)
(* split was specified, implemented, measured slower and not adopted;     *)
(* NOTES-M4) and K0 as a kernel with one CTA per tensor's vectors          *)
(* (VecResident = FALSE, IMD_VEC_GENERATE). Added positives:              *)
(*   pos_k1_split     K1 as K1a (γ) + K1b (σ), otherwise pos_g2           *)
(*   pos_k1_split_two_streams  the split K1 with two streams (edge: K1b)  *)
(*   pos_resident_g2  IMD_VEC_RESIDENT: vectors in the plan's buffer, no   *)
(*                    K0, no vec region (workspace 352); otherwise pos_g2  *)
(*   pos_resident_k0  IMD_VEC_RESIDENT, k = 0: workspace 0                 *)
(*   pos_resident_direct  IMD_VEC_RESIDENT, DIRECT: workspace 0            *)
(* Negative models (must fail with the named invariant):                   *)
(*   neg_two_streams_no_events   NoStaleRead       (§4: v1 single-stream)   *)
(*   neg_pack_before_retire      ReuseAfterRetire  (WAR edge dropped)       *)
(*   neg_region_short            AccessesSafe      (RB one unit short)      *)
(*   neg_ws_short                AccessesSafe      (ws_bytes = size - 1)    *)
(*   neg_store_mod               PlanesFinalAtCRT  (c > 0 stores)           *)
(*   neg_crt_early               PlanesFinalAtCRT  (K5 before last GEMM)    *)
(*   neg_ignore_fb               CorrectPath       (flag = fA only)         *)
(*   neg_alpha0_k5_full          NoStaleRead       (α = 0, K5 normal path)  *)
(*   neg_beta0_reads_c           BetaZeroNoCRead   (β = 0 but C read)       *)
(*   neg_alias_ca                NoInputClobber    (C aliases A)            *)
(*   neg_alias_cb                NoInputClobber    (C aliases B)            *)
(*   neg_no_pad                  NoStaleRead       (K pad junk in A and B)  *)
(*   neg_chunk_misaligned        GemmAligned       (K_c' = 3, not % 2)      *)
(*   neg_no_align                RegionsAligned    (offsets not rounded)    *)
(*   neg_no_split                LaunchGridOK      (gridDim.z > MaxZ)       *)
(*   neg_rb_stride_n             LayoutExact       (RB blocks n rows apart) *)
(*   neg_ra_sized_n              LayoutExact       (RA sized N, not g)      *)
(*   neg_over_alloc_k0           RegionsUsed       (k = 0, all regions)     *)
(*   neg_kempty_emulate          AccessesSafe      (K-empty run EMULATE     *)
(*                                                  with the DIRECT size)   *)
(*   neg_ysplit_none             LaunchGridYOK     (n̂ not split: GridY 2   *)
(*                                                  > MaxY 1)               *)
(*   neg_ysplit_overlap          PlanesWrittenOnce (off by one, inclusive  *)
(*                                                  end: a column written   *)
(*                                                  by two launches)        *)
(*   neg_ysplit_floor            PlanesFinalAtCRT  (off by one, floor(n̂ /  *)
(*                                                  YLen) launches: the     *)
(*                                                  tail is never computed) *)
(*   neg_ytile_misaligned        GemmAligned       (TileN = 3 not % AlignN *)
(*                                                  = 2: a y part's B / W   *)
(*                                                  pointer misaligned)     *)
(*   v1.2:                                                                 *)
(*   neg_k0_no_c                 NoStaleRead       (K0 grid misses C's     *)
(*                                                  vectors)               *)
(*   neg_k1_merged               NoStaleRead       (K1a, K1b in one launch) *)
(*   neg_k1_no_sigma             SigmaFinalAtUse   (K1b dropped: packs read *)
(*                                                  γ as σ)                *)
(*   neg_k1_sigma_row_split      NoStaleRead       (two K1b CTAs per row,   *)
(*                                                  σ written over γ early) *)
(*   neg_k1_pack_waits_gamma     SigmaFinalAtUse   (2 streams, the packs'  *)
(*                                                  edge from K1a)         *)
(*   neg_resident_ws_vec         RegionsUsed       (resident vectors and a  *)
(*                                                  vec region anyway)     *)
(*   neg_resident_reads_ws       AccessesSafe      (resident, kernels read  *)
(*                                                  the absent ws vec)     *)
(*   v1.4 (Fused = the KF launch: K0 + K1 + group 1's packs; MParts =     *)
(*   CTAs per row of a pack launch, one per moduli part; every model above *)
(*   has Fused = FALSE, MParts = 1):                                       *)
(*   pos_fused_g3        KF, g = N, two parts                              *)
(*   pos_fused_g1        KF, g = 1: groups 2, 3 by K2/K3 reading KF's σ    *)
(*   pos_fused_g2_parts  KF, g = 2, two parts (group 2's part 0 empty),    *)
(*                       z split                                           *)
(*   pos_fused_resident  KF with resident vectors (no vec CTAs)            *)
(*   pos_fused_batch2    KF, b = 2, m = 2, n = 1, g = 2, two parts         *)
(*   pos_pack_parts      unfused, K2/K3 with two parts                     *)
(*   neg_fused_reads_vec     NoStaleRead (KF reads its own launch's vec)   *)
(*   neg_fused_shared_sigma  NoStaleRead (part 1 reads part 0's σ)         *)
(*   neg_fused_no_vec        NoStaleRead (no vec CTAs: K5 reads junk)      *)
(*   neg_fused_no_sigma      NoStaleRead (σ not stored: group 2 / K5)      *)
(*   neg_fused_all_groups    NoStaleRead (all groups packed by one KF)     *)
(*   v1.6 (FusedLarge = operands scaled + packed by one KL launch each:   *)
(*   K1 of the operand and its group-1 pack; every model above has        *)
(*   FusedLarge = {}):                                                     *)
(*   pos_large_g3        KL for A and B, g = N                             *)
(*   pos_large_g1        KL for A and B, g = 1: groups 2, 3 by K2/K3       *)
(*                       reading KL's σ                                    *)
(*   pos_large_a_g2      KL for A only (B: K1 + K3), g = 2, z split        *)
(*   pos_large_b_resident KL for B only (it zeroes RB rows n..n̂-1), A by   *)
(*                       K1 + K2, resident vectors (no K0), g = 2          *)
(*   pos_large_batch2    KL for A and B, b = 2, m = 2, n = 1, g = 2        *)
(*   neg_large_with_k0     NoStaleRead (K0 and KL in one launch: KL reads  *)
(*                         vectors not yet written)                        *)
(*   neg_large_row_split   NoStaleRead (a row over two CTAs; segment 1     *)
(*                         reads segment 0's σ in the same launch)         *)
(*   neg_large_no_sigma    NoStaleRead (σ not stored: K5 reads junk)       *)
(*   neg_large_all_groups  NoStaleRead (all groups packed by one KL)       *)
(*   D1 (Packed = post-swap roles read from a caller's packed buffer,     *)
(*   DESIGN §6b; every model above has Packed = {}):                       *)
(*   pos_packed_a        A packed: no K1 / K2 for A, K4 and K5 read the    *)
(*                       pack; no sA, fA, RA; g = 2, z split               *)
(*   pos_packed_b        B packed, b = 2, n = 1 (n̂ = 2): K4 reads n̂ rows   *)
(*                       per block at batch stride r·k̂ (row 1 = the next   *)
(*                       block's row 0, or the tail)                       *)
(*   pos_packed_both     both packed: K0, K4, K5 only; b = 2, g = 1        *)
(*   pos_packed_fused_b  KF with B packed: KF packs A only, two parts      *)
(*   pos_packed_fused_both  Fused, both packed: no KF, K0 alone            *)
(*   pos_packed_large    KL for A, B packed                                *)
(*   pos_packed_resident A packed, resident vectors                        *)
(*   pos_packed_k0 / pos_packed_direct  k = 0 / DIRECT: never read         *)
(*   neg_packed_ws_full    RegionsUsed  (sA, fA, RA still allocated)       *)
(*   neg_packed_k1         AccessesSafe (K1 writes the absent sA / fA)     *)
(*   neg_packed_k3         AccessesSafe (K3 writes the absent RB)          *)
(*   neg_packed_reads_ws   NoStaleRead  (K4 reads the absent RA: junk)     *)
(*   neg_packed_sigma_ws   NoStaleRead  (K5 reads σ from the absent sB)    *)
(*   neg_packed_b_stride   NoStaleRead  (role B read at v1's n̂·k̂ block    *)
(*                                       stride: another row / plane)      *)
(*   neg_packed_no_tail    AccessesSafe (no tail: the last block's rows    *)
(*                                       r..n̂−1 past the residue region)   *)
(*   neg_packed_in_flight  NoStaleRead  (imd_pack still running: the       *)
(*                                       caller's RAW edge is necessary)   *)
(* (GemmAligned, RegionsAligned, LaunchGridOK, LaunchGridYOK, LayoutExact *)
(*  are constant-                                                          *)
(*  level; TLC reports them as "The invariant of X is equal to FALSE".)   *)
(***************************************************************************)
EXTENDS Pipeline

WsExact  == WorkspaceSize          \* ON the boundary ws_bytes >= workspace_size
WsMinus1 == WorkspaceSize - 1      \* boundary + 1
=============================================================================
