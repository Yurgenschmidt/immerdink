---------------------------- MODULE MC_HostAPI ----------------------------
(***************************************************************************)
(* Model values for HostAPI (DESIGN v1.2 §6: thread safety, plan lifetime). *)
(* Every constant is a boolean, a small integer or a string, so the cfgs    *)
(* set them directly; this module only provides the module check.sh runs.  *)
(*                                                                         *)
(* Positive models (must pass), v1.2 unless noted:                         *)
(*   pos_shared_plan     NT = 3 threads share one plan, own workspaces and *)
(*                       streams; the plan is destroyed once the three     *)
(*                       calls returned, GPU work possibly pending         *)
(*   pos_shared_stream   NT = 2 share one plan AND one stream, own         *)
(*                       workspaces: their launches interleave on the      *)
(*                       stream (harmless)                                 *)
(*   pos_own_plans       NT = 3, a plan each: concurrent creation, calls   *)
(*                       and destruction                                   *)
(*   pos_resident        IMD_VEC_RESIDENT, NT = 3 sharing it; destroyed  *)
(*                       after the GPU work (the resident lifetime rule) *)
(*   pos_v11             v1.1 as built (per-call CUTLASS operators, whose  *)
(*                       device properties are thread_local in CUTLASS     *)
(*                       v4.8.0; pinned K0) under the v1.1 lifetime rule   *)
(*                       (destroy after the GPU work): also safe           *)
(* Negative models (must fail with the named invariant):                   *)
(*   neg_pinned_early_destroy     NoUseAfterFree  v1.1 pinned K0 + the v1.2 *)
(*                                                lifetime rule            *)
(*   neg_resident_early_destroy   NoUseAfterFree  a resident plan destroyed *)
(*                                                once its call returned   *)
(*   neg_lazy_cache               NoHostRace      parameter cache filled by *)
(*                                                the first imd_contract   *)
(*   neg_shared_op                ParamsOwn       one mutable operator per  *)
(*                                                plan                     *)
(*   neg_global_lazy              NoHostRace      lazily initialized        *)
(*                                                process-global state,    *)
(*                                                own plans                *)
(*   neg_ws_shared                NoWsHazard      one workspace, 2 streams *)
(*   neg_ws_shared_same_stream    NoWsHazard      one workspace, ONE stream:*)
(*                                                two threads' launches    *)
(*                                                still interleave         *)
(* Witnesses (must fail: the positive configurations reach the case their  *)
(* rule is about, so they do not pass vacuously):                          *)
(*   neg_witness_early_destroy    NeverDestroyedEarly  (pos_shared_plan)   *)
(*   neg_witness_concurrent_read  NeverConcurrentRead  (pos_shared_plan)   *)
(*   neg_witness_interleave       NeverInterleaved     (pos_shared_stream) *)
(*                                                                         *)
(* D1 pack handle (DESIGN §6b.7; every model above has PackMode = "none"): *)
(*   pos_pack_shared     NT = 3 share one plan and one handle H1: imd_pack, *)
(*                       plan creation and contracts read it; H1 destroyed *)
(*                       once every call passed it returned (imd_pack      *)
(*                       kernels possibly pending)                         *)
(*   pos_pack_own_plans  NT = 2 create their plans from H1 concurrently    *)
(*   pos_pack_new_handle the contracts are given a new handle H2 with the  *)
(*                       same key; H1 destroyed after the imd_pack calls   *)
(*                       returned: the plans outlive their creation handle *)
(*   neg_pack_lazy       NoHostRace       a cache in the handle filled by  *)
(*                                        the first call (own plans)       *)
(*   neg_pack_plan_ptr   NoUseAfterFree   the plan keeps a pointer to H1   *)
(*                                        instead of copying the key       *)
(*   neg_pack_gpu_reads  NoUseAfterFree   the pack kernel reads the handle *)
(*   neg_pack_shared_buf NoPackBufHazard  two imd_pack calls into one      *)
(*                                        packed buffer concurrently       *)
(*   neg_witness_handle_early      NeverHandleDestroyedEarly (pos_pack_shared)    *)
(*   neg_witness_plan_outlives     NeverPlanOutlivesHandle   (pos_pack_new_handle)*)
(*   neg_witness_handle_concurrent NeverConcurrentRead       (pos_pack_own_plans) *)
(***************************************************************************)
EXTENDS HostAPI
=============================================================================
